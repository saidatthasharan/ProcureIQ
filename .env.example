# SERVER-SIDE ONLY. This file is read by server.ts, never by the browser.
# Never rename this to VITE_GEMINI_API_KEY or expose it with Vite `define`:
# anything prefixed VITE_ is bundled into the public JavaScript.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional. Default: gemini-3.8-flash (listed as stable on Google's models page, Nov 2026).
# GEMINI_MODEL="gemini-3.8-flash"

# Optional. Default 3000.
# PORT=3000

APP_URL="MY_APP_URL"
